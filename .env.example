# 复制为 .env 后按需修改；全部留空也能用默认值启动
POSTGRES_PASSWORD=change-me
APP_PORT=8081

# 生产环境务必换成随机字符串
SECRET_KEY=
COOKIE_SECURE=false

# 反向代理后才需要开（也可在后台「系统设置 → 信任反向代理」切换）
TRUST_PROXY=false

# 单张图片上传大小上限（MB），也可在后台「系统设置 → 上传限制」修改
MAX_UPLOAD_MB=5

# 项目创建日期（YYYY-MM-DD），首页「稳定交付 N 天」按它算；也可在后台「系统设置」改
# SITE_LAUNCH_DATE=2026-02-11
